rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerifiedOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 3. Entity Validation Blueprints (verbatim bounds from firebase-blueprint.json)
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
        'uid',
        'email',
        'displayName',
        'photoURL',
        'primaryXyphAddress',
        'primaryEvmAddress',
        'createdAt',
        'updatedAt',
        'lastSignInAt'
      ])
      && data.keys().hasOnly([
        'uid',
        'email',
        'displayName',
        'photoURL',
        'primaryXyphAddress',
        'primaryEvmAddress',
        'createdAt',
        'updatedAt',
        'lastSignInAt'
      ])
      && data.uid is string
      && data.uid == request.auth.uid
      && data.uid == userId
      && data.uid.size() >= 1 && data.uid.size() <= 128
      && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
      && data.email is string
      && data.email.size() >= 3 && data.email.size() <= 254
      && data.displayName is string
      && data.displayName.size() >= 1 && data.displayName.size() <= 100
      && data.photoURL is string
      && data.photoURL.size() <= 512
      && data.primaryXyphAddress is string
      && data.primaryXyphAddress.size() <= 64
      && data.primaryEvmAddress is string
      && data.primaryEvmAddress.size() <= 64
      && data.createdAt is timestamp
      && data.updatedAt is timestamp
      && data.lastSignInAt is timestamp;
    }

    function isValidLinkedWallet(data, userId, walletId) {
      return data.keys().hasAll([
        'walletId',
        'ownerUid',
        'label',
        'xyphAddress',
        'evmAddress',
        'walletType',
        'createdAt',
        'updatedAt'
      ])
      && data.keys().hasOnly([
        'walletId',
        'ownerUid',
        'label',
        'xyphAddress',
        'evmAddress',
        'walletType',
        'createdAt',
        'updatedAt'
      ])
      && data.walletId is string
      && data.walletId == walletId
      && data.walletId.size() >= 1 && data.walletId.size() <= 64
      && data.walletId.matches('^[a-zA-Z0-9_\\-]+$')
      && data.ownerUid is string
      && data.ownerUid == request.auth.uid
      && data.ownerUid == userId
      && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128
      && data.ownerUid.matches('^[a-zA-Z0-9_\\-]+$')
      && data.label is string
      && data.label.size() >= 1 && data.label.size() <= 60
      && data.xyphAddress is string
      && data.xyphAddress.size() >= 1 && data.xyphAddress.size() <= 64
      && data.evmAddress is string
      && data.evmAddress.size() <= 64
      && data.walletType is string
      && data.walletType in ['local', 'metamask', 'solana']
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    // 4. Private User Profiles (PII Isolated to Owner Only)
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isVerifiedOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && incoming().lastSignInAt == request.time;

      allow update: if isVerifiedOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: Sync Google sign-in metadata & primary public addresses
          (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'email',
              'displayName',
              'photoURL',
              'primaryXyphAddress',
              'primaryEvmAddress',
              'updatedAt',
              'lastSignInAt'
            ])
            && incoming().lastSignInAt == request.time
          ) ||
          // Action: Update primary public wallet addresses
          (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'primaryXyphAddress',
              'primaryEvmAddress',
              'updatedAt'
            ])
          )
        );

      allow delete: if isVerifiedOwner(userId) && isValidId(userId);

      // 5. Owner-Only Linked Public Wallets Subcollection (Master Gate checks parent profile exists)
      match /wallets/{walletId} {
        allow get: if isValidId(userId) && isValidId(walletId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.ownerUid == request.auth.uid;

        allow create: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(walletId)
          && isValidLinkedWallet(incoming(), userId, walletId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(walletId)
          && isValidLinkedWallet(incoming(), userId, walletId)
          && incoming().walletId == existing().walletId
          && incoming().ownerUid == existing().ownerUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId))
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'label',
            'xyphAddress',
            'evmAddress',
            'updatedAt'
          ]);

        allow delete: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(walletId)
          && exists(/databases/$(database)/documents/users/$(userId));
      }
    }
  }
}
