<script>
"use strict";
const TOKEN = "__TOKEN__";
const UNIT = 1e8;
const $ = id => document.getElementById(id);
const LS = "xypher.keys";

/* ---------- byte helpers ---------- */
const hex = u => [...u].map(b => b.toString(16).padStart(2, "0")).join("");
const unhex = h => Uint8Array.from((h.match(/../g) || []), x => parseInt(x, 16));
const utf8 = s => new TextEncoder().encode(s);
function cat(...as) {
  const n = as.reduce((s, a) => s + a.length, 0), o = new Uint8Array(n);
  let i = 0; for (const a of as) { o.set(a, i); i += a.length; } return o;
}
const sha = async b => new Uint8Array(await crypto.subtle.digest("SHA-256", b));
const dsha = async b => sha(await sha(b));

/* ---------- base58 ---------- */
const B58 = "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz";
function b58enc(u8) {
  let n = 0n; for (const b of u8) n = n * 256n + BigInt(b);
  let out = ""; while (n > 0n) { out = B58[Number(n % 58n)] + out; n /= 58n; }
  for (const b of u8) { if (b !== 0) break; out = "1" + out; }
  return out;
}
function b58dec(s) {
  let n = 0n; for (const c of s) { const i = B58.indexOf(c); if (i < 0) throw new Error("bad base58"); n = n * 58n + BigInt(i); }
  const out = []; while (n > 0n) { out.unshift(Number(n % 256n)); n /= 256n; }
  for (const c of s) { if (c !== "1") break; out.unshift(0); }
  return Uint8Array.from(out);
}

/* ---------- secp256k1 ---------- */
const P = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEFFFFFC2Fn;
const N = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364141n;
const GX = 0x79BE667EF9DCBBAC55A06295CE870B07029BFCDB2DCE28D959F2815B16F81798n;
const GY = 0x483ADA7726A3C4655DA4FBFC0E1108A8FD17B448A68554199C47D08FFB10D4B8n;
const M = x => ((x % P) + P) % P;
const modpow = (b, e, m) => { let r = 1n; b %= m; while (e > 0n) { if (e & 1n) r = r * b % m; b = b * b % m; e >>= 1n; } return r; };
const inv = (x, m) => modpow(x, m - 2n, m);
const b32 = n => unhex(n.toString(16).padStart(64, "0"));

function jd(a) {
  const [X, Y, Z] = a;
  if (Y === 0n) return [0n, 1n, 0n];
  const yy = M(Y * Y), s = M(4n * X * yy), m = M(3n * X * X);
  const x3 = M(m * m - 2n * s), y3 = M(m * (s - x3) - 8n * yy * yy);
  return [x3, y3, M(2n * Y * Z)];
}
function ja(a, b) {
  if (a[2] === 0n) return b;
  if (b[2] === 0n) return a;
  const [x1, y1, z1] = a, [x2, y2, z2] = b;
  const z1z1 = M(z1 * z1), z2z2 = M(z2 * z2);
  const u1 = M(x1 * z2z2), u2 = M(x2 * z1z1);
  const s1 = M(M(y1 * z2) * z2z2), s2 = M(M(y2 * z1) * z1z1);
  if (u1 === u2) return s1 === s2 ? jd(a) : [0n, 1n, 0n];
  const h = M(u2 - u1), r = M(s2 - s1), h2 = M(h * h), h3 = M(h * h2);
  const x3 = M(r * r - h3 - 2n * u1 * h2);
  const y3 = M(r * M(u1 * h2 - x3) - s1 * h3);
  return [x3, y3, M(M(h * z1) * z2)];
}
function jm(pt, k) {
  k %= N; let out = [0n, 1n, 0n], add = [pt[0], pt[1], 1n];
  while (k > 0n) { if (k & 1n) out = ja(out, add); add = jd(add); k >>= 1n; }
  return out;
}
function aff([X, Y, Z]) {
  if (Z === 0n) return null;
  const zi = inv(Z, P), zi2 = M(zi * zi);
  return [M(X * zi2), M(Y * zi2 * zi)];
}
function pubOf(priv) {
  const pt = aff(jm([GX, GY], BigInt("0x" + hex(priv))));
  return cat(b32(pt[0]), b32(pt[1]));
}
function derInt(n) {
  let h = n.toString(16); if (h.length % 2) h = "0" + h;
  let b = unhex(h);
  if (b[0] & 0x80) b = cat(Uint8Array.of(0), b);
  return cat(Uint8Array.of(2, b.length), b);
}
async function signDigest(dig, priv) {
  const d = BigInt("0x" + hex(priv)), z = BigInt("0x" + hex(dig)) % N;
  for (;;) {
    let k; do { k = BigInt("0x" + hex(crypto.getRandomValues(new Uint8Array(32)))); } while (k === 0n || k >= N);
    const R = aff(jm([GX, GY], k)); if (!R) continue;
    const r = R[0] % N; if (r === 0n) continue;
    let s = inv(k, N) * (z + r * d) % N; if (s === 0n) continue;
    if (s > N / 2n) s = N - s;
    const body = cat(derInt(r), derInt(s));
    return cat(Uint8Array.of(0x30, body.length), body);
  }
}

/* ---------- WIF ---------- */
async function toWif(priv) {
  const p = cat(Uint8Array.of(0xa8), priv);
  return b58enc(cat(p, (await dsha(p)).slice(0, 4)));
}
function fromWif(w) {
  const raw = b58dec(w.trim());
  if (raw.length !== 37 || raw[0] !== 0xa8) throw new Error("not a WIF key");
  const body = raw.slice(0, 33);
  return { priv: body.slice(1) };
}

/* ---------- rpc ---------- */
async function rpc(method, params = {}) {
  const r = await fetch("/rpc", {
    method: "POST", headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ id: Date.now(), token: TOKEN, method, params })
  });
  const j = await r.json();
  if (j.error) throw new Error(j.error);
  return j.result;
}

/* ---------- state ---------- */
let keys = [];
const state = { info: null, mining: false, busy: false };

const fmt = u => (u / UNIT).toFixed(8);
function toUnits(s) {
  const t = String(s).trim();
  if (!/^\d*(\.\d*)?$/.test(t) || t === "" || t === ".") throw new Error("bad number");
  const [a, b = ""] = t.split(".");
  return Number(a || "0") * UNIT + Number((b + "00000000").slice(0, 8));
}

function log(msg, cls) {
  const el = document.createElement("div");
  el.innerHTML = `<b>${new Date().toLocaleTimeString()}</b> ` +
    (cls ? `<span class="${cls}">${msg.replace(/</g, "&lt;")}</span>` : msg.replace(/</g, "&lt;"));
  const box = $("log");
  box.appendChild(el); box.scrollTop = box.scrollHeight;
  while (box.children.length > 400) box.removeChild(box.firstChild);
}

async function loadKeys() {
  const stored = JSON.parse(localStorage.getItem(LS) || "[]");
  keys = [];
  for (const w of stored) {
    const { priv } = fromWif(w);
    const pub = pubOf(priv);
    const { address } = await rpc("addr", { pub: hex(pub) });
    keys.push({ priv, pub, address });
  }
  renderAddrs();
}

function persist() {
  localStorage.setItem(LS, JSON.stringify(keys.map(k => b58enc(cat(
    Uint8Array.of(0xa8), k.priv, new Uint8Array(0)
  )))));
}

async function persistAsync() {
  const out = [];
  for (const k of keys) out.push(await toWif(k.priv));
  localStorage.setItem(LS, JSON.stringify(out));
}

/* ---------- tabs ---------- */
document.querySelectorAll("nav button").forEach(b => {
  b.onclick = () => {
    document.querySelectorAll("nav button").forEach(x => x.classList.remove("sel"));
    document.querySelectorAll("section").forEach(x => x.classList.remove("sel"));
    b.classList.add("sel"); $(b.dataset.t).classList.add("sel");
  };
});

/* ---------- addresses ---------- */
function renderAddrs(balances = {}) {
  const box = $("addrs");
  box.innerHTML = "";
  if (!keys.length) { box.className = "hint"; box.textContent = "no addresses yet"; return; }
  box.className = "";
  keys.forEach((k, i) => {
    const row = document.createElement("div");
    row.className = "addr";
    const bal = balances[k.address] ? fmt(balances[k.address].spendable) : "…";
    row.innerHTML = `<span class="a">${k.address}</span><span class="b">${bal}</span>`;
    const copy = document.createElement("button");
    copy.className = "ghost"; copy.textContent = "copy";
    copy.onclick = () => { navigator.clipboard.writeText(k.address); log("copied " + k.address); };
    row.appendChild(copy);
    box.appendChild(row);
  });
  const opts = keys.map(k => `<option value="${k.address}">${k.address}</option>`).join("");
  for (const id of ["from", "mineaddr"]) {
    const keep = $(id).value;
    $(id).innerHTML = opts;
    if (keys.some(k => k.address === keep)) $(id).value = keep;
  }
}

$("new").onclick = async () => {
  const priv = crypto.getRandomValues(new Uint8Array(32));
  const pub = pubOf(priv);
  const { address } = await rpc("addr", { pub: hex(pub) });
  keys.push({ priv, pub, address });
  await persistAsync(); renderAddrs();
  log("created " + address, "good");
  poll();
};

$("imp").onclick = async () => {
  const w = prompt("Paste a WIF private key:");
  if (!w) return;
  try {
    const { priv } = fromWif(w);
    const pub = pubOf(priv);
    const { address } = await rpc("addr", { pub: hex(pub) });
    if (keys.some(k => k.address === address)) return log("already imported", "warn");
    keys.push({ priv, pub, address });
    await persistAsync(); renderAddrs();
    log("imported " + address, "good");
  } catch (e) { log("import failed: " + e.message, "err"); }
};

$("exp").onclick = async () => {
  if (!keys.length) return;
  const out = [];
  for (const k of keys) out.push(k.address + "\n" + await toWif(k.priv));
  prompt("Private keys — copy and store offline:", out.join("\n\n"));
};

/* ---------- send ---------- */
$("amount").oninput = $("fee").oninput = () => {
  try {
    const a = toUnits($("amount").value || "0"), f = toUnits($("fee").value || "0");
    $("prev").textContent = `total ${fmt(a + f)} __SYMBOL__`;
  } catch { $("prev").textContent = "invalid number"; }
};

$("max").onclick = async () => {
  const ad = $("from").value;
  if (!ad) return;
  try {
    const b = await rpc("balance", { address: ad });
    const fee = toUnits($("fee").value || "0");
    $("amount").value = fmt(Math.max(0, b.spendable - fee));
    $("amount").oninput();
  } catch (e) { log("max failed: " + e.message, "err"); }
};

async function canonical(tx, pubIdx) {
  const ins = "[" + tx.ins.map((i, n) =>
    `{"index": ${i.index}, "prev_txid": "${i.prev_txid}"` +
    (n === pubIdx ? `, "pub": "${i.pub}"` : "") + "}"
  ).join(", ") + "]";
  const outs = "[" + tx.outs.map(o =>
    `{"addr": "${o.addr}", "value": ${o.value}}`).join(", ") + "]";
  return `{"ins": ${ins}, "outs": ${outs}, "v": ${tx.v}}`;
}

async function sighash(tx, idx) {
  const le = new Uint8Array(4);
  new DataView(le.buffer).setUint32(0, tx.ins[idx].index, true);
  return dsha(cat(utf8(await canonical(tx, idx)), Uint8Array.of(0x7c),
                  unhex(tx.ins[idx].prev_txid), le));
}

async function buildTx(sk, coins, to, amount, fee) {
  const need = amount + fee;
  coins.sort((a, b) => b[2] - a[2]);
  const picked = []; let total = 0;
  for (const c of coins) { picked.push(c); total += c[2]; if (total >= need) break; }
  if (total < need) throw new Error(`insufficient funds: have ${fmt(total)}, need ${fmt(need)}`);
  const tx = { v: 1, ins: picked.map(c => ({ prev_txid: c[0], index: c[1], pub: "", sig: "" })),
               outs: [{ addr: to, value: amount }] };
  if (total - need > 0) tx.outs.push({ addr: sk.address, value: total - need });
  for (let i = 0; i < tx.ins.length; i++) {
    tx.ins[i].pub = hex(sk.pub);
    tx.ins[i].sig = hex(await signDigest(await sighash(tx, i), sk.priv));
  }
  return tx;
}

$("send").onclick = async () => {
  if (state.busy) return;
  const ad = $("from").value, to = $("to").value.trim();
  const sk = keys.find(k => k.address === ad);
  if (!sk) return ($("res").textContent = "no source address");
  try {
    const amount = toUnits($("amount").value), fee = toUnits($("fee").value || "0");
    if (amount <= 0) throw new Error("amount must be positive");
    state.busy = true; $("send").disabled = true;
    $("res").textContent = "signing…";
    const coins = await rpc("coins", { address: ad });
    const tx = await buildTx(sk, coins, to, amount, fee);
    const r = await rpc("submit", { tx });
    $("res").textContent = "accepted " + r.txid;
    log("sent " + fmt(amount) + " to " + to + " — " + r.txid, "good");
    $("amount").value = ""; $("prev").textContent = "";
  } catch (e) {
    $("res").textContent = "failed: " + e.message;
    log("send failed: " + e.message, "err");
  } finally { state.busy = false; $("send").disabled = false; poll(); }
};

/* ---------- mining ---------- */
$("minetoggle").onclick = async () => {
  try {
    if (state.mining) { await rpc("mine_stop"); log("mining stopped", "warn"); }
    else {
      const ad = $("mineaddr").value;
      if (!ad) throw new Error("no payout address");
      await rpc("mine_start", { address: ad });
      log("mining to " + ad, "good");
    }
  } catch (e) { log("mining error: " + e.message, "err"); }
  poll();
};

/* ---------- polling ---------- */
async function poll() {
  try {
    const info = await rpc("getinfo");
    const ms = await rpc("minestatus");
    state.info = info; state.mining = ms.mining;
    $("dot").className = "dot on"; $("conn").textContent = "connected";
    $("h").textContent = info.height.toLocaleString();
    $("p").textContent = info.peers;
    $("s").textContent = fmt(info.supply);
    $("who").textContent = `${info.name} · ${info.profile}`;
    $("minetoggle").textContent = ms.mining ? "Stop mining" : "Start mining";
    $("minestat").textContent = ms.mining
      ? `${Math.round(ms.hashrate).toLocaleString()} H/s · found ${ms.found}` : "";
    const bal = {};
    for (const k of keys) bal[k.address] = await rpc("balance", { address: k.address });
    renderAddrs(bal);
  } catch (e) {
    $("dot").className = "dot off";
    $("conn").textContent = "node unreachable";
  }
  setTimeout(poll, 3000);
}

/* ---------- boot ---------- */
loadKeys().then(() => { log("wallet ready"); poll(); })
  .catch(e => { log("boot failed: " + e.message, "err"); poll(); });
</script></body></html>
