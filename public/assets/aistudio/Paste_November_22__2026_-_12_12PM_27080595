class Rpc:
    def __init__(self, host, port, token):
        self.host, self.port, self.token = host, port, token

    def call(self, method, **params):
        req = {"id": 1, "token": self.token, "method": method, "params": params}
        with socket.create_connection((self.host, self.port), timeout=20) as s:
            s.sendall(json.dumps(req).encode() + b"\n")
            buf = b""
            while b"\n" not in buf:
                chunk = s.recv(65536)
                if not chunk:
                    break
                buf += chunk
        r = json.loads(buf.split(b"\n")[0])
        if "error" in r:
            raise RuntimeError(r["error"])
        return r.get("result")


class Wallet:
    def __init__(self, path):
        self.path = path
        d = os.path.dirname(path)
        if d:
            os.makedirs(d, exist_ok=True)
        self.keys = load_keys(path)

    def new(self):
        k = new_key()
        self.keys.append(k)
        save_keys(self.path, self.keys)
        return address(k)


def cmd_wallet(a):
    try:
        import tkinter as tk
        from tkinter import ttk
    except ImportError:
        raise SystemExit("tkinter missing — Debian/Ubuntu: sudo apt install python3-tk")
    if not os.path.exists(a.token_file):
        raise SystemExit(f"no RPC token at {a.token_file} — start the node first")
    with open(a.token_file) as f:
        token = f.read().strip()
    w = Wallet(os.path.join(a.wallet_dir, "keys.json"))
    if not w.keys:
        w.new()
    root = tk.Tk()
    WalletApp(root, Rpc(a.rpc_host, a.rpc_port, token), w, tk, ttk)
    root.mainloop()


class WalletApp:
    POLL = 2500

    def __init__(self, root, rpc, wallet, tk, ttk):
        self.root, self.rpc, self.wallet = root, rpc, wallet
        self.tk, self.ttk = tk, ttk
        self.q = queue.Queue()
        self.mining = False
        self.busy = False
        root.title(f"Xypher Wallet — {SYMBOL}")
        root.geometry("900x600")
        self._build()
        self._drain()
        self._poll()
        self.log(f"{len(wallet.keys)} key(s) loaded")

    def _build(self):
        tk, ttk = self.tk, self.ttk
        bar = ttk.Frame(self.root, padding=(10, 8)); bar.pack(fill="x")
        self.dot = tk.Canvas(bar, width=12, height=12, highlightthickness=0)
        self.dot_id = self.dot.create_oval(2, 2, 11, 11, fill="#999"); self.dot.pack(side="left")
        self.state_lbl = ttk.Label(bar, text="connecting…"); self.state_lbl.pack(side="left", padx=6)
        self.height_lbl = ttk.Label(bar, text="height —"); self.height_lbl.pack(side="left", padx=6)
        self.peers_lbl = ttk.Label(bar, text="peers —"); self.peers_lbl.pack(side="left", padx=6)
        self.supply_lbl = ttk.Label(bar, text="supply —"); self.supply_lbl.pack(side="left", padx=6)
        ttk.Button(bar, text="Refresh", command=self._poll).pack(side="right")

        nb = ttk.Notebook(self.root); nb.pack(fill="both", expand=True, padx=10, pady=(0, 6))

        tab = ttk.Frame(nb, padding=10); nb.add(tab, text="Addresses")
        self.addr_tree = ttk.Treeview(tab, columns=("a", "b"), show="headings", height=12)
        self.addr_tree.heading("a", text="Address"); self.addr_tree.heading("b", text="Spendable")
        self.addr_tree.column("a", width=580, anchor="w"); self.addr_tree.column("b", width=140, anchor="e")
        self.addr_tree.pack(fill="both", expand=True)
        self.addr_tree.bind("<<TreeviewSelect>>", self._on_select)
        row = ttk.Frame(tab); row.pack(fill="x", pady=(8, 0))
        ttk.Button(row, text="New address", command=self._new_addr).pack(side="left")
        ttk.Button(row, text="Copy", command=self._copy).pack(side="left", padx=6)

        tab = ttk.Frame(nb, padding=10); nb.add(tab, text="Send")
        f = ttk.Frame(tab); f.pack(fill="x", pady=4)
        ttk.Label(f, text="From", width=8).pack(side="left")
        self.from_var = tk.StringVar()
        self.from_box = ttk.Combobox(f, textvariable=self.from_var, state="readonly")
        self.from_box.pack(side="left", fill="x", expand=True)
        f = ttk.Frame(tab); f.pack(fill="x", pady=4)
        ttk.Label(f, text="To", width=8).pack(side="left")
        self.to_var = tk.StringVar(); ttk.Entry(f, textvariable=self.to_var).pack(side="left", fill="x", expand=True)
        f = ttk.Frame(tab); f.pack(fill="x", pady=4)
        ttk.Label(f, text="Amount", width=8).pack(side="left")
        self.amount_var = tk.StringVar(); ttk.Entry(f, textvariable=self.amount_var, width=22).pack(side="left")
        ttk.Button(f, text="Max", command=self._max).pack(side="left", padx=6)
        ttk.Label(f, text="Fee").pack(side="left", padx=(14, 4))
        self.fee_var = tk.StringVar(value="0.0001"); ttk.Entry(f, textvariable=self.fee_var, width=14).pack(side="left")
        self.prev_lbl = ttk.Label(tab, text=""); self.prev_lbl.pack(anchor="w", pady=(10, 0))
        ttk.Button(tab, text="Send payment", command=self._send).pack(anchor="w", pady=10)
        self.res_lbl = ttk.Label(tab, text="", wraplength=820); self.res_lbl.pack(anchor="w")
        self.amount_var.trace_add("write", lambda *_: self._preview())
        self.fee_var.trace_add("write", lambda *_: self._preview())

        tab = ttk.Frame(nb, padding=10); nb.add(tab, text="Mining")
        f = ttk.Frame(tab); f.pack(fill="x", pady=4)
        ttk.Label(f, text="Payout", width=8).pack(side="left")
        self.mine_var = tk.StringVar()
        self.mine_box = ttk.Combobox(f, textvariable=self.mine_var, state="readonly")
        self.mine_box.pack(side="left", fill="x", expand=True)
        row = ttk.Frame(tab); row.pack(fill="x", pady=8)
        self.mine_btn = ttk.Button(row, text="Start mining", command=self._toggle_mine)
        self.mine_btn.pack(side="left")
        self.hash_lbl = ttk.Label(row, text="— H/s"); self.hash_lbl.pack(side="left", padx=16)
        self.found_lbl = ttk.Label(row, text="found: 0"); self.found_lbl.pack(side="left")

        tab = ttk.Frame(nb, padding=10); nb.add(tab, text="Activity")
        self.log_widget = tk.Text(tab, height=14, wrap="word", state="disabled")
        self.log_widget.pack(fill="both", expand=True)

    def log(self, msg):
        self.log_widget.configure(state="normal")
        self.log_widget.insert("end", f"[{time.strftime('%H:%M:%S')}] {msg}\n")
        self.log_widget.see("end"); self.log_widget.configure(state="disabled")

    def _set_state(self, ok, text):
        self.dot.itemconfigure(self.dot_id, fill="#2e9e4f" if ok else "#c0392b")
        self.state_lbl.configure(text=text)

    def _async(self, work, done):
        def run():
            try: self.q.put((done, work(), None))
            except Exception as e: self.q.put((done, None, e))
        threading.Thread(target=run, daemon=True).start()

    def _drain(self):
        while True:
            try: done, res, err = self.q.get_nowait()
            except queue.Empty: break
            try: done(res, err)
            except Exception as e: self.log(f"ui error: {e}")
        self.root.after(120, self._drain)

    def _key_for(self, addr):
        for k in self.wallet.keys:
            if address(k) == addr:
                return k

    def _poll(self):
        addrs = [address(k) for k in self.wallet.keys]
        def work():
            out = {"info": self.rpc.call("getinfo"), "mine": self.rpc.call("minestatus"), "bal": {}}
            for ad in addrs:
                out["bal"][ad] = self.rpc.call("balance", address=ad)
            return out
        self._async(work, self._apply)
        self.root.after(self.POLL, self._poll)

    def _apply(self, res, err):
        if err:
            self._set_state(False, f"node unreachable — {err}")
            return
        i = res["info"]
        self._set_state(True, "connected")
        self.height_lbl.configure(text=f"height {i['height']:,}")
        self.peers_lbl.configure(text=f"peers {i['peers']}")
        self.supply_lbl.configure(text=f"supply {i['supply']/UNIT:,.2f} {SYMBOL}")
        sel = self.addr_tree.selection()
        keep = self.addr_tree.item(sel[0])["values"][0] if sel else None
        self.addr_tree.delete(*self.addr_tree.get_children())
        for ad, b in res["bal"].items():
            self.addr_tree.insert("", "end", values=(ad, f"{b['spendable']/UNIT:.8f}"))
        vals = list(res["bal"].keys())
        self.from_box["values"] = vals; self.mine_box["values"] = vals
        if not self.from_var.get() and vals: self.from_var.set(vals[0])
        if not self.mine_var.get() and vals: self.mine_var.set(vals[0])
        m = res["mine"]
        self.mining = m["mining"]
        self.mine_btn.configure(text="Stop mining" if self.mining else "Start mining")
        self.hash_lbl.configure(text=f"{m['hashrate']:,.0f} H/s" if self.mining else "— H/s")
        self.found_lbl.configure(text=f"found: {m['found']}")

    def _new_addr(self):
        ad = self.wallet.new(); self.log(f"new address {ad}"); self._poll()

    def _selected(self):
        sel = self.addr_tree.selection()
        return self.addr_tree.item(sel[0])["values"][0] if sel else None

    def _copy(self):
        ad = self._selected()
        if ad:
            self.root.clipboard_clear(); self.root.clipboard_append(ad); self.log(f"copied {ad}")

    def _on_select(self, _e):
        ad = self._selected()
        if ad:
            self.from_var.set(ad); self.mine_var.set(ad); self._preview()

    def _preview(self):
        try:
            a = Decimal(self.amount_var.get() or "0"); f = Decimal(self.fee_var.get() or "0")
            self.prev_lbl.configure(text=f"{a:.8f} + {f:.8f} fee = {a + f:.8f} {SYMBOL}")
        except Exception:
            self.prev_lbl.configure(text="invalid number")

    def _max(self):
        ad = self.from_var.get()
        if not ad: return
        try:
            b = self.rpc.call("balance", address=ad)["spendable"]
            self.amount_var.set(f"{max(0, b - to_units(self.fee_var.get() or '0'))/UNIT:.8f}")
        except Exception as e:
            self.log(f"max failed: {e}")

    def _send(self):
        if self.busy: return
        ad, to = self.from_var.get(), self.to_var.get().strip()
        sk = self._key_for(ad)
        if not sk: return self.res_lbl.configure(text="select a source address")
        try:
            amount, fee = to_units(self.amount_var.get()), to_units(self.fee_var.get())
        except Exception:
            return self.res_lbl.configure(text="invalid amount")
        def work():
            coins = self.rpc.call("coins", address=ad)
            tx = build_from_coins(sk, coins, to, amount, fee)
            return self.rpc.call("submit", tx=tx.to_dict())
        self.busy = True; self.res_lbl.configure(text="signing…")
        self._async(work, self._sent)

    def _sent(self, res, err):
        self.busy = False
        if err:
            self.res_lbl.configure(text=f"failed: {err}"); self.log(f"send failed: {err}"); return
        self.res_lbl.configure(text=f"accepted: {res['txid']}"); self.log(f"broadcast {res['txid']}")
        self.amount_var.set(""); self._poll()

    def _toggle_mine(self):
        ad = self.mine_var.get()
        if not ad: return self.log("choose a payout address")
        was = self.mining
        def work():
            return self.rpc.call("mine_stop") if was else self.rpc.call("mine_start", address=ad)
        self._async(work, lambda r, e: self.log(
            f"mining {'stopped' if was else 'started'}" if not e else f"mining error: {e}"))


