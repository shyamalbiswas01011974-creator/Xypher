def load_keys(path):
    if not os.path.exists(path):
        return []
    with open(path) as f:
        return [wif_to_key(w) for w in json.load(f)["keys"]]


def save_keys(path, keys):
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump({"keys": [key_to_wif(k) for k in keys]}, f, indent=2)
    os.replace(tmp, path)
    try:
        os.chmod(path, 0o600)
    except OSError:
        pass


def add_key(path, key):
    keys = load_keys(path); keys.append(key); save_keys(path, keys)
    return address(key)


def build_from_coins(sk, coins, to, amount, fee):
    if amount <= 0:
        raise ValueError("amount must be positive")
    if fee < 0:
        raise ValueError("fee must not be negative")
    if not is_address(to):
        raise ValueError("invalid destination address")
    frm = address(sk)
    need = amount + fee
    picked, total = [], 0
    for txid, idx, value in sorted(coins, key=lambda c: -c[2]):
        picked.append((txid, idx)); total += value
        if total >= need:
            break
    if total < need:
        raise ValueError(f"insufficient spendable funds: have {total/UNIT:.8f} XYPH, "
                         f"need {need/UNIT:.8f} XYPH")
    outs = [TxOut(amount, to)]
    if total - need:
        outs.append(TxOut(total - need, frm))
    tx = Tx(1, [TxIn(t, i) for t, i in picked], outs)
    for i in range(len(tx.ins)):
        tx.sign_input(i, sk)
    return tx


def build_payment(chain, sk, to, amount, fee):
    coins = [(k[0], k[1], v) for k, v in chain.spendable(address(sk))]
    return build_from_coins(sk, coins, to, amount, fee)


