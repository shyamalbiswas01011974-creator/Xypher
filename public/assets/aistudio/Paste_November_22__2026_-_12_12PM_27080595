def to_units(s):
    return int((Decimal(str(s)) * UNIT).to_integral_value())


def show(units):
    return f"{Decimal(units) / UNIT:.8f}"


def open_chain():
    if not os.path.exists(CHAIN_PATH):
        raise SystemExit(f"no chain in {DATA} — run: python xypher.py init")
    return Chain.open(CHAIN_PATH)


def cmd_init(a):
    _, fund = init_chain(DATA)
    save_keys(KEYS_PATH, [fund])
    print(f"chain initialised in {DATA}")
    print(f"fund address: {address(fund)}")
    print(f"fund WIF saved to {KEYS_PATH} — back this up")


def cmd_address(a):
    if a.action == "new":
        print(add_key(KEYS_PATH, new_key()))
    else:
        for k in load_keys(KEYS_PATH):
            print(address(k))


def cmd_balance(a):
    c = open_chain()
    imm = c.balance(a.address) - sum(v for _, v in c.spendable(a.address))
    print(f"{a.address}: {show(c.balance(a.address))} XYPH ({show(imm)} immature)")


def cmd_info(a):
    c = open_chain()
    print(f"{NAME} ({SYMBOL}) profile={PROFILE}")
    print(f"height {c.height}  tip {c.tip.hash}")
    print(f"supply {show(sum(v for v, *_ in c.utxo.values()))} XYPH")
    print(f"next subsidy {show(c.subsidy(c.height + 1))} XYPH  "
          f"blocks left to cap {max(0, MAX_BLOCKS - c.height)}")
    print(f"next target {hex(c.next_target(c.height + 1))}")
    print(f"mempool {len(c.mempool)} tx")


def cmd_send(a):
    c = open_chain()
    keys = {address(k): k for k in load_keys(KEYS_PATH)}
    if a.sender not in keys:
        raise SystemExit("sender not in wallet")
    tx = build_payment(c, keys[a.sender], a.to, to_units(a.amount), to_units(a.fee))
    ok, msg = c.add_tx(tx)
    print(f"{tx.txid()} -> {msg}")


def cmd_mine(a):
    c = open_chain()
    start = c.height
    while True:
        b = mine(c, a.to)
        ok, msg = c.add_block(b)
        print(f"block {b.height} accepted: {msg}\n")
        if a.blocks and b.height - start >= a.blocks:
            return


def cmd_validate(a):
    c = open_chain()
    print(f"valid, height {c.height}, {len(c.utxo)} utxos")


def cmd_node(a):
    Node(open_chain(), a.port, a.seed, a.rpc_port, a.web_port, not a.no_web).start()


def cmd_webwallet(a):
    url = f"http://127.0.0.1:{a.web_port}/"
    try:
        urllib.request.urlopen(url, timeout=4).read()
    except Exception:
        raise SystemExit(f"no web wallet at {url} — is the node running?")
    print(f"opening {url}")
    webbrowser.open(url)


def cmd_selftest(a):
    global COINBASE_MATURITY
    saved = COINBASE_MATURITY
    COINBASE_MATURITY = 3
    d = tempfile.mkdtemp()
    try:
        one = Key(b"\x00" * 31 + b"\x01")
        assert pubkey(one) == GX.to_bytes(32, "big") + GY.to_bytes(32, "big")
        dg = sha256(b"xypher"); sg = sign(one, dg)
        assert verify(pubkey(one), dg, sg)
        assert not verify(pubkey(one), sha256(b"other"), sg)
        bad = bytearray(sg); bad[-2] ^= 0x01
        assert not verify(pubkey(one), dg, bytes(bad))
        print("crypto vectors ok")

        chain, fund = init_chain(d)
        keys = os.path.join(d, "wallet.json")
        save_keys(keys, [fund])
        a_addr = add_key(keys, new_key())
        b_addr = address(new_key())
        fund_addr = chain.meta["fund_address"]

        for _ in range(5):
            ok, msg = chain.add_block(mine(chain, a_addr, log_every=10 ** 9))
            assert ok, msg
        assert chain.balance(a_addr) == 5 * MINER_SHARE
        assert chain.balance(fund_addr) == 5 * (BLOCK_SUBSIDY - MINER_SHARE)
        assert len(chain.spendable(a_addr)) == 3
        print("mining + split + maturity ok")

        sk = load_keys(keys)[0]
        tx = build_payment(chain, sk, b_addr, 3 * UNIT, UNIT // 100)
        assert chain.add_tx(tx)[0]
        ok, msg = chain.add_tx(build_payment(chain, sk, b_addr, 2 * UNIT, UNIT // 100))
        assert not ok and msg == "mempool-conflict"
        print("double-spend rejected ok")

        assert chain.add_block(mine(chain, a_addr, log_every=10 ** 9))[0]
        assert chain.balance(b_addr) == 3 * UNIT
        print("payment confirmed ok")

        tx3 = build_payment(chain, sk, b_addr, UNIT, 1000)
        tx3.ins[0].sig = "00" * 8
        ok, msg = chain.add_tx(tx3)
        assert not ok and msg == "bad-signature"
        print("bad signature rejected ok")

        blk = mine(chain, a_addr, log_every=10 ** 9); blk.target //= 2
        ok, msg = chain.add_block(blk)
        assert not ok and msg == "bad-target"
        print("wrong target rejected ok")

        try:
            build_payment(chain, sk, b_addr, 10_000 * UNIT, 0); raise AssertionError
        except ValueError:
            print("overspend rejected ok")

        assert Chain.open(os.path.join(d, "chain.jsonl")).height == chain.height
        print("persistence ok")

        fake = type("N", (), {"peers": [], "on_tx": lambda s, t, p=None: chain.add_tx(t),
                              "on_block": lambda s, b, p=None: chain.add_block(b),
                              "broadcast": lambda *x, **y: None})()
        rpc = RpcServer(fake, chain, 0)
        r = rpc._handle({"id": 1, "token": rpc.token, "method": "balance",
                         "params": {"address": b_addr}})
        assert r["result"]["total"] == 3 * UNIT, r
        assert rpc._handle({"id": 2, "token": rpc.token, "method": "addr",
                            "params": {"pub": pubkey(one).hex()}})["result"]["address"] == address(one)
        assert "error" in rpc._handle({"id": 3, "token": "nope", "method": "getinfo"})
        print("rpc ok")

        web = WebServer(("127.0.0.1", 0), rpc)
        threading.Thread(target=web.serve_forever, daemon=True).start()
        base = f"http://127.0.0.1:{web.server_address[1]}"
        page = urllib.request.urlopen(base + "/", timeout=5).read().decode()
        assert rpc.token in page and "Xypher" in page
        req = urllib.request.Request(
            base + "/rpc", data=json.dumps({"method": "balance",
                                            "params": {"address": b_addr}}).encode(),
            headers={"Content-Type": "application/json"})
        assert json.loads(urllib.request.urlopen(req, timeout=5).read())["result"]["total"] == 3 * UNIT
        web.shutdown()
        print("web wallet ok\nALL PASS")
    finally:
        shutil.rmtree(d, ignore_errors=True)
        COINBASE_MATURITY = saved


def main():
    if os.path.isdir("xypher") and os.path.basename(sys.argv[0]).endswith(".py"):
        print("note: a ./xypher/ directory exists; python -m xypher would load that instead",
              file=sys.stderr)
    p = argparse.ArgumentParser(
        prog="xypher", description="Xypher (XYPH) node and wallets",
        epilog="run 'xypher <command> -h' for command options")
    sub = p.add_subparsers(dest="cmd")

    sub.add_parser("init", help="create a new chain").set_defaults(fn=cmd_init)
    s = sub.add_parser("address", help="create or list node-wallet addresses")
    s.add_argument("action", choices=["new", "list"]); s.set_defaults(fn=cmd_address)
    s = sub.add_parser("balance", help="show an address balance")
    s.add_argument("address"); s.set_defaults(fn=cmd_balance)
    sub.add_parser("info", help="chain height, supply, target").set_defaults(fn=cmd_info)
    sub.add_parser("status", help="alias for info").set_defaults(fn=cmd_info)
    s = sub.add_parser("send", help="send from the node wallet")
    s.add_argument("--from", dest="sender", required=True)
    s.add_argument("--to", required=True)
    s.add_argument("--amount", required=True)
    s.add_argument("--fee", default="0.0001")
    s.set_defaults(fn=cmd_send)
    s = sub.add_parser("mine", help="mine blocks")
    s.add_argument("--to", required=True)
    s.add_argument("--blocks", type=int, default=0)
    s.set_defaults(fn=cmd_mine)
    sub.add_parser("validate", help="replay and verify the chain").set_defaults(fn=cmd_validate)
    sub.add_parser("selftest", help="run the built-in end-to-end test").set_defaults(fn=cmd_selftest)
    s = sub.add_parser("node", help="run the chain, P2P, RPC and web wallet")
    s.add_argument("--port", type=int, default=9333)
    s.add_argument("--rpc-port", type=int, default=9334)
    s.add_argument("--web-port", type=int, default=9335)
    s.add_argument("--no-web", action="store_true")
    s.add_argument("--seed", action="append", default=[])
    s.set_defaults(fn=cmd_node)
    s = sub.add_parser("wallet", help="open the Tkinter wallet")
    s.add_argument("--rpc-host", default="127.0.0.1")
    s.add_argument("--rpc-port", type=int, default=9334)
    s.add_argument("--token-file", default=TOKEN_PATH)
    s.add_argument("--wallet-dir", default=WALLET_DIR)
    s.set_defaults(fn=cmd_wallet)
    s = sub.add_parser("webwallet", help="open the browser wallet")
    s.add_argument("--web-port", type=int, default=9335)
    s.set_defaults(fn=cmd_webwallet)

    a = p.parse_args()
    if not getattr(a, "fn", None):
        p.print_help()
        print()
        if os.path.exists(CHAIN_PATH):
            try: cmd_info(a)
            except SystemExit: pass
        else:
            print(f"no chain in {DATA} — start with: python {os.path.basename(sys.argv[0])} init")
        return
    a.fn(a)


if __name__ == "__main__":
    main()

