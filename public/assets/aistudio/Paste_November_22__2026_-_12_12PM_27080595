class WebHandler(BaseHTTPRequestHandler):
    def _send(self, code, body, ctype):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        if self.path.split("?")[0] not in ("/", "/index.html"):
            return self._send(404, b"not found", "text/plain")
        page = (PAGE.replace("__TOKEN__", self.server.rpc.token)
                    .replace("__SYMBOL__", SYMBOL)
                    .replace("__MATURITY__", str(COINBASE_MATURITY)))
        self._send(200, page.encode(), "text/html; charset=utf-8")

    def do_POST(self):
        if self.path != "/rpc":
            return self._send(404, b"not found", "text/plain")
        n = int(self.headers.get("Content-Length") or 0)
        try:
            req = json.loads(self.rfile.read(n) or b"{}")
        except Exception:
            req = {}
        req["token"] = self.server.rpc.token
        req.setdefault("id", 1)
        out = json.dumps(self.server.rpc._handle(req)).encode()
        self._send(200, out, "application/json")

    def log_message(self, *a):
        pass


class WebServer(ThreadingHTTPServer):
    allow_reuse_address = True

    def __init__(self, addr, rpc):
        self.rpc = rpc
        super().__init__(addr, WebHandler)

    def serve_in_background(self):
        url = f"http://127.0.0.1:{self.server_address[1]}/"
        print(f"web wallet on {url}")
        threading.Thread(target=self.serve_forever, daemon=True).start()


