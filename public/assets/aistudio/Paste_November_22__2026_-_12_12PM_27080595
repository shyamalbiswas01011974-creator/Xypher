# RPC
# =====================================================================
class RpcServer:
    def __init__(self, node, chain, port):
        self.node, self.chain, self.port = node, chain, port
        self.token = os.urandom(16).hex()
        self.mining = False
        self.miner_addr = None
        self.found = 0
        self.hashrate = 0.0
        self.lock = threading.Lock()

    def start(self):
        os.makedirs(DATA, exist_ok=True)
        with open(TOKEN_PATH, "w") as f:
            f.write(self.token)
        try:
            os.chmod(TOKEN_PATH, 0o600)
        except OSError:
            pass
        srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        srv.bind(("127.0.0.1", self.port)); srv.listen(16)
        print(f"RPC on 127.0.0.1:{self.port}  (token: {TOKEN_PATH})")
        threading.Thread(target=self._accept, args=(srv,), daemon=True).start()

    def _accept(self, srv):
        while True:
            sock, _ = srv.accept()
            threading.Thread(target=self._serve, args=(sock,), daemon=True).start()

    def _serve(self, sock):
        buf = b""
        try:
            while True:
                chunk = sock.recv(65536)
                if not chunk:
                    break
                buf += chunk
                while b"\n" in buf:
                    line, buf = buf.split(b"\n", 1)
                    if len(line) > MAX_LINE:
                        return
                    sock.sendall((json.dumps(self._handle(json.loads(line))) + "\n").encode())
        except Exception:
            pass
        finally:
            try: sock.close()
            except OSError: pass

    def _handle(self, req):
        rid = req.get("id")
        if req.get("token") != self.token:
            return {"id": rid, "error": "bad token"}
        fn = getattr(self, "rpc_" + str(req.get("method")), None)
        if fn is None:
            return {"id": rid, "error": f"unknown method {req.get('method')}"}
        try:
            return {"id": rid, "result": fn(**(req.get("params") or {}))}
        except TypeError as e:
            return {"id": rid, "error": f"bad params: {e}"}
        except Exception as e:
            return {"id": rid, "error": str(e)}

    def rpc_getinfo(self):
        c = self.chain
        with c.lock:
            tgt = c.next_target(c.height + 1)
            return {"name": NAME, "symbol": SYMBOL, "profile": PROFILE,
                    "height": c.height, "tip": c.tip.hash,
                    "supply": sum(v for v, *_ in c.utxo.values()),
                    "mempool": len(c.mempool), "peers": len(self.node.peers),
                    "blocks_left": max(0, MAX_BLOCKS - c.height),
                    "target": tgt, "difficulty": MAX_TARGET / tgt,
                    "maturity": COINBASE_MATURITY}

    def rpc_balance(self, address):
        c = self.chain
        with c.lock:
            total = c.balance(address)
            spend = sum(v for _, v in c.spendable(address))
            return {"total": total, "spendable": spend, "immature": total - spend}

    def rpc_coins(self, address):
        with self.chain.lock:
            return [[k[0], k[1], v] for k, v in self.chain.spendable(address)]

    def rpc_addr(self, pub):
        return {"address": b58check(bytes([ADDR_VERSION]) + hash160(bytes.fromhex(pub)))}

    def rpc_submit(self, tx):
        t = Tx.from_dict(tx)
        ok, msg = self.node.on_tx(t)
        if not ok:
            raise RuntimeError(msg)
        return {"txid": t.txid()}

    def rpc_mine_start(self, address):
        if not is_address(address):
            raise RuntimeError("invalid address")
        with self.lock:
            if self.mining:
                raise RuntimeError("already mining")
            self.mining, self.miner_addr, self.found = True, address, 0
        threading.Thread(target=self._mine_loop, daemon=True).start()
        return {"mining": True}

    def rpc_mine_stop(self):
        self.mining = False
        return {"mining": False}

    def rpc_minestatus(self):
        return {"mining": self.mining, "address": self.miner_addr,
                "hashrate": self.hashrate, "found": self.found}

    def _mine_loop(self):
        try:
            while self.mining:
                blk = mine(self.chain, self.miner_addr, verbose=False,
                           progress=self._progress, stop=lambda: not self.mining)
                if blk is None:
                    break
                ok, msg = self.node.on_block(blk)
                if ok:
                    self.found += 1
                    print(f"mined {blk.height} {blk.hash[:16]}")
                else:
                    print(f"mined block rejected: {msg}")
        finally:
            self.hashrate = 0.0
            self.mining = False

    def _progress(self, hashes, rate):
        self.hashrate = rate


